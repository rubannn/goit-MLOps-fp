# Фаза 2.5). Placeholders below, NOT real credentials.
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=<your-minio-root-password>
